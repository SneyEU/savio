{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fenêtre principale. Le réseau est limité aux serveurs IA locaux.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://127.0.0.1:*" }, { "url": "http://localhost:*" }]
    }
  ]
}
