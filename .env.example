# Copier en .env (jamais commité). Toutes les variables sont optionnelles :
# l'application fonctionne sans aucune configuration.

# Provider IA par défaut au premier lancement : ollama | openai-compatible | offline
VITE_DEFAULT_AI_PROVIDER=ollama
# Adresse locale d'Ollama
VITE_OLLAMA_URL=http://127.0.0.1:11434
# Modèle par défaut (à installer avec : ollama pull qwen2.5:3b)
VITE_OLLAMA_MODEL=qwen2.5:3b

# Ne mettez JAMAIS de clé d'API dans ce fichier s'il est partagé.
# Les clés éventuelles se saisissent dans Réglages et restent sur votre machine.
