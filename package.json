{
  "name": "savio",
  "private": true,
  "version": "0.2.0",
  "description": "Plateforme éducative IA libre, gratuite et locale : révision espacée, tuteur IA, langues, échecs, islam et plus.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check": "npm run lint && npm run typecheck && npm run test",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.1.0",
    "@fontsource/fredoka": "^5.1.0",
    "@tauri-apps/api": "^2.7.0",
    "@tauri-apps/plugin-http": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-sql": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tauri-apps/cli": "^2.7.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
